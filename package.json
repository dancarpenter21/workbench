{
  "name": "robotic-workbench",
  "private": true,
  "workspaces": ["apps/dashboard", "packages/contracts"],
  "scripts": {
    "start": "uv run --no-sync python scripts/dev.py",
    "stop": "uv run --no-sync python scripts/stop.py",
    "dev": "uv run --no-sync python scripts/dev.py",
    "dev:mock": "uv run --no-sync python scripts/dev.py --mode mock",
    "build": "npm run build --workspace @workbench/dashboard",
    "contracts": "uv run python scripts/export_contracts.py && openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/api.d.ts && uv run --no-sync python scripts/export_ros_contracts.py",
    "check": "npm run check --workspace @workbench/dashboard",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "openapi-typescript": "^7.6.1", "@playwright/test": "^1.63.0" }
}
