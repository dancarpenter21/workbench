#!/usr/bin/env python3
"""Configure and activate owners once; failures stop bringup without retrying."""

import rclpy
from lifecycle_msgs.msg import Transition
from lifecycle_msgs.srv import ChangeState
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node

rclpy.init()
node = Node("workbench_lifecycle_manager")
try:
    for name in ("vision", "workbench_arm_owner"):
        client = node.create_client(ChangeState, f"/{name}/change_state")
        if not client.wait_for_service(timeout_sec=30):
            raise RuntimeError(f"Lifecycle service unavailable: {name}")
        for transition in (Transition.TRANSITION_CONFIGURE, Transition.TRANSITION_ACTIVATE):
            future = client.call_async(ChangeState.Request(transition=Transition(id=transition)))
            rclpy.spin_until_future_complete(node, future, timeout_sec=30)
            if not future.done() or future.exception() or not future.result().success:
                raise RuntimeError(f"Lifecycle transition failed: {name}/{transition}; no retry")
        node.destroy_client(client)
    node.get_logger().info("Camera and monitored arm owners active")
    rclpy.spin(node)
except (KeyboardInterrupt, ExternalShutdownException):
    pass
finally:
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()
